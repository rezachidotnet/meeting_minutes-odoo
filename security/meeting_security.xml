<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="privilege_meeting_minutes" model="res.groups.privilege">
            <field name="name">Meeting Minutes</field>
            <field name="sequence">35</field>
            <field name="category_id" ref="base.module_category_productivity"/>
        </record>
        <record id="group_meeting_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_meeting_minutes"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_meeting_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="privilege_meeting_minutes"/>
            <field name="implied_ids" eval="[(4, ref('group_meeting_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
    <data noupdate="1">
        <record id="rule_meeting_company" model="ir.rule">
            <field name="name">Meeting Minutes: company isolation</field>
            <field name="model_id" ref="model_cyan_meeting_minute"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_resolution_company" model="ir.rule">
            <field name="name">Meeting Resolutions: company isolation</field>
            <field name="model_id" ref="model_cyan_meeting_resolution"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_resolution_user_write_own" model="ir.rule">
            <field name="name">Meeting Resolutions: users write assigned actions</field>
            <field name="model_id" ref="model_cyan_meeting_resolution"/>
            <field name="groups" eval="[(4, ref('group_meeting_user'))]"/>
            <field name="domain_force">[('responsible_id', '=', user.id)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_resolution_manager_write_all" model="ir.rule">
            <field name="name">Meeting Resolutions: managers write company actions</field>
            <field name="model_id" ref="model_cyan_meeting_resolution"/>
            <field name="groups" eval="[(4, ref('group_meeting_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
