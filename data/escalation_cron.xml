<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_resolution_escalation" model="ir.cron">
            <field name="name">Meeting Minutes: Check overdue resolution escalation</field>
            <field name="model_id" ref="model_cyan_meeting_resolution"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_overdue_escalations()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 01:00:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
